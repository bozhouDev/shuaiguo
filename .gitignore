# 系统文件
.DS_Store
# v1 旧代码备份，不进仓库
_backup_v1/
# 像素素材切图中间产物（可由 assets_pixel/cut_sheets.py 重新生成）
assets_pixel/sprites/
# 字体源文件（约 19 MB，可按 build_fonts.py 里的地址重新下载）
assets_pixel/fonts_src/
# 音频原始文件（约 30 MB，来源地址记在 assets_audio/sources.json，可重新下载或生成）
assets_audio/src/
port/tmp/

# P2-2 新录像由冻结原型重建；只入库工具和含 SHA-256 的 extra-manifest.json
tests/golden/input/*.json.gz
tests/golden/tutorial/*.json.gz
tests/golden/buffs/*.json.gz
tests/golden/ads/*.json.gz

# Cocos 3.8.8 本机缓存和构建产物；settings/ 与素材 meta 需要入库
cocos/library/
cocos/temp/
cocos/local/
cocos/build/
cocos/profiles/
cocos/node_modules/
cocos/.vscode/
cocos/.idea/
cocos/.venv/
